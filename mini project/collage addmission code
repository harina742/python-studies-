      /* ---------- GENERAL ---------- */

body{
    margin:0;
    padding:0;
    font-family: Arial, Helvetica, sans-serif;
    background:#f4f6f9;
    color:#333;
}

/* ---------- HEADER ---------- */

header{
    background:linear-gradient(135deg,#4b0082,#6a0dad);
    color:white;
    text-align:center;
    padding:30px;
}

header img{
    border-radius:50%;
}

header h1{
    margin-top:10px;
}

.hero{
    text-align:center;
    padding:60px;
    background:white;
}

.hero h2{
    color:#4b0082;
    font-size:40px;
}

.btn{
    display:inline-block;
    background:#6a0dad;
    color:white;
    padding:15px 30px;
    text-decoration:none;
    border-radius:10px;
    margin-top:20px;
    font-size:18px;
}

.btn:hover{
    background:#4b0082;
}

/* ---------- CARDS ---------- */

.cards{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:20px;
    padding:20px;
}

.card{
    background:white;
    width:280px;
    padding:20px;
    border-radius:15px;
    box-shadow:0px 3px 15px rgba(0,0,0,0.15);
    text-align:center;
    transition:0.3s;
}

.card:hover{
    transform:translateY(-8px);
}

/* ---------- SECTIONS ---------- */

section{
    padding:40px;
}

section h2{
    text-align:center;
    color:#4b0082;
}

/* ---------- FORM ---------- */

.form-container{

    width:85%;
    max-width:1200px;

    margin:30px auto;

    background:white;

    padding:30px;

    border-radius:15px;

    box-shadow:0 0 15px rgba(0,0,0,0.15);
}

.form-container h1{
    text-align:center;
    color:#4b0082;
}

.form-container p{
    text-align:center;
}

.row{
    display:flex;
    gap:20px;
    margin-bottom:15px;
}

.column{
    flex:1;
}

label{
    display:block;
    margin-bottom:5px;
    font-weight:bold;
}

input,
select{

    width:100%;

    padding:12px;

    border:1px solid #ccc;

    border-radius:8px;

    box-sizing:border-box;
}

button{

    background:#6a0dad;

    color:white;

    border:none;

    padding:12px 25px;

    border-radius:8px;

    cursor:pointer;

    margin-right:10px;
}

button:hover{
    background:#4b0082;
}

/* ---------- TABLE ---------- */

table{

    width:100%;

    border-collapse:collapse;

    background:white;
}

th{

    background:#6a0dad;

    color:white;

    padding:12px;
}

td{

    padding:10px;

    text-align:center;
}

tr:nth-child(even){
    background:#f1ebff;
}

/* ---------- DASHBOARD ---------- */

.dashboard-cards{

    display:flex;

    gap:20px;

    justify-content:center;

    flex-wrap:wrap;
}

.stat-card{

    width:250px;

    background:white;

    padding:25px;

    border-radius:15px;

    text-align:center;

    box-shadow:0 0 15px rgba(0,0,0,0.15);
}

.stat-card h3{
    color:#4b0082;
}

/* ---------- FOOTER ---------- */

footer{

    background:#4b0082;

    color:white;

    text-align:center;

    padding:20px;

    margin-top:30px;
}

/* ---------- MOBILE ---------- */

@media(max-width:768px){

    .row{
        flex-direction:column;
    }

    .cards{
        flex-direction:column;
        align-items:center;
    }

    .dashboard-cards{
        flex-direction:column;
        align-items:center;
    }
}
